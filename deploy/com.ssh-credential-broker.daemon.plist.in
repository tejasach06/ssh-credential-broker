<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.ssh-credential-broker.daemon</string>
<key>ProgramArguments</key><array>
<string>/opt/ssh-credential-broker/bin/ssh-brokerd</string>
<string>--runtime-dir</string><string>/private/var/db/ssh-credential-broker/run</string>
<string>--operator-uid</string><string>@OPERATOR_UID@</string>
<string>--harness-uid</string><string>@HARNESS_UID@</string>
<string>--exec-gid</string><string>@EXEC_GID@</string>
<string>--admin-gid</string><string>@ADMIN_GID@</string>
</array>
<key>UserName</key><string>sshbroker</string>
<key>GroupName</key><string>sshbroker</string>
<key>InitGroups</key><true/>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>2</integer>
<key>Umask</key><integer>63</integer>
<key>SoftResourceLimits</key><dict><key>Core</key><integer>0</integer></dict>
<key>HardResourceLimits</key><dict><key>Core</key><integer>0</integer></dict>
<key>ProcessType</key><string>Background</string>
</dict></plist>
