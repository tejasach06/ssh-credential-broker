[Unit]
Description=Memory-only SSH credential broker
After=network.target

[Service]
Type=simple
User=sshbroker
Group=sshbroker
SupplementaryGroups=sshbroker-exec sshbroker-admin
EnvironmentFile=/etc/ssh-credential-broker/daemon.env
ExecStart=/opt/ssh-credential-broker/bin/ssh-brokerd --runtime-dir /run/ssh-credential-broker --operator-uid ${OPERATOR_UID} --harness-uid ${HARNESS_UID} --exec-gid ${EXEC_GID} --admin-gid ${ADMIN_GID}
RuntimeDirectory=ssh-credential-broker
RuntimeDirectoryMode=0751
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/ssh-credential-broker
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardInput=null
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
